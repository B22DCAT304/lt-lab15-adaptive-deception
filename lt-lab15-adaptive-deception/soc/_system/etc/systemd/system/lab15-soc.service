[Unit]
Description=LAB15 Lightweight SOC Receiver
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -o ubuntu -g ubuntu -m 0755 /var/log/lab15-soc
ExecStart=/usr/bin/python3 /usr/local/bin/lab15-soc-receiver
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
