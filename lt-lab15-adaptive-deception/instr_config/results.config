_probe = ssh-decoy:/var/log/lab15/probes.jsonl : FILE_REGEX : (?=.*"eventid": "lab15\.probe\.detected")(?=.*"src_ip": "172\.31\.65\.50")
_rec = soc:/var/log/lab15-soc/recommendations.jsonl : FILE_REGEX : (?=.*"eventid": "lab15\.deception\.recommended")(?=.*"src_ip": "172\.31\.65\.50")(?=.*"risk_score": 80)
_denied = ssh-decoy:/var/log/lab15/orchestration.jsonl : FILE_REGEX : (?=.*"eventid": "lab15\.activation\.denied")(?=.*"reason": "missing_approval")
_approval = ssh-decoy:/var/log/lab15/orchestration.jsonl : FILE_REGEX : "eventid": "lab15\.human_approval\.granted"
_consumed = ssh-decoy:/var/log/lab15/orchestration.jsonl : FILE_REGEX : "eventid": "lab15\.approval\.consumed"
_active = ssh-decoy:/var/log/lab15/orchestration.jsonl : FILE_REGEX : (?=.*"eventid": "lab15\.honeypot\.activated")(?=.*"src_ip": "172\.31\.65\.50")
_reuse = ssh-decoy:/var/log/lab15/orchestration.jsonl : FILE_REGEX : (?=.*"eventid": "lab15\.activation\.denied")(?=.*"reason": "approval_consumed")
_policy = ssh-decoy:/var/log/lab15/policy.log : FILE_REGEX : LAB15_POLICY default_deny=yes scope=ssh port=2222 least_privilege=yes
_decoy = ssh-decoy:/var/log/lab15/decoy.jsonl : FILE_REGEX : (?=.*"eventid": "lab15\.session\.connect")(?=.*"src_ip": "172\.31\.65\.50")
_alert = soc:/var/log/lab15-soc/alerts.jsonl : FILE_REGEX : (?=.*"eventid": "lab15\.alert\.high")(?=.*"severity": "high")(?=.*"src_ip": "172\.31\.65\.50")
_integrity = soc:/var/log/lab15-soc/integrity-check.txt : FILE_REGEX : LAB15_EVIDENCE_INTEGRITY_PASS
_firewall = ssh-decoy:/var/log/lab15/policy-verify.txt : FILE_REGEX : LAB15_FIREWALL_STATE_PASS
_postblock = ext-client:/var/log/lab15/post-block.out : FILE_REGEX : LAB15_POST_BLOCK_PASS: attacker connection dropped
_report = soc:/var/log/lab15-soc/report-check.txt : FILE_REGEX : LAB15_INCIDENT_REPORT_PASS
