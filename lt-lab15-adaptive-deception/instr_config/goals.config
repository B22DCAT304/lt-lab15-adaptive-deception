ssh_probe_detected = boolean : (_probe)
#DOC ssh_probe_detected : Sensor recorded probing from the external client.
soc_recommendation_confirmed = boolean : (_rec)
#DOC soc_recommendation_confirmed : SOC created a risk-based deception recommendation.
unapproved_activation_denied = boolean : (_denied)
#DOC unapproved_activation_denied : Activation without approval was denied.
human_approved_activation = boolean : (_approval and _consumed and _active and _policy)
#DOC human_approved_activation : Human approval was consumed and the SSH honeypot activated.
one_time_approval_enforced = boolean : (_reuse)
#DOC one_time_approval_enforced : Reusing an already consumed approval was denied.
honeypot_soc_evidence_verified = boolean : (_decoy and _alert and _integrity)
#DOC honeypot_soc_evidence_verified : Attacker session, HIGH alert and evidence integrity were verified.
containment_incident_verified = boolean : (_firewall and _postblock and _report)
#DOC containment_incident_verified : Firewall containment, post-block test and incident report were verified.
